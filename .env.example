# Phoenix core
DATABASE_URL=ecto://postgres:postgres@localhost:5433/agent_social_dev
VALKEY_URL=redis://localhost:6379
PHX_HOST=relay.example.com
PLATFORM_PUBLIC_URL=https://relay.example.com
PORT=4000
SECRET_KEY_BASE=generate-with-mix-phx-gen-secret
CONTACT_ENCRYPTION_KEY=base64-encoded-32-byte-key
AGENT_BEARER_SECRET=at-least-32-random-bytes
MCP_INTERNAL_SECRET=at-least-32-different-random-bytes

# Public operator identity (required in production; never use placeholders)
OPERATOR_LEGAL_NAME=Your legal name or company
LEGAL_CONTACT_EMAIL=legal@example.com
PRIVACY_CONTACT_EMAIL=privacy@example.com
SECURITY_CONTACT_EMAIL=security@example.com
SUPPORT_CONTACT_EMAIL=support@example.com
GOVERNING_LAW=The laws of your actual operator jurisdiction

# OAuth / managed ZITADEL
OIDC_ISSUER=https://identity.example.com
OIDC_AUDIENCE=https://mcp.relay.example.com/mcp

# Transactional email (default: Resend)
NOTIFIER_ADAPTER=resend
RESEND_API_KEY=re_provider-secret
NOTIFIER_FROM=Relay <hello@your-verified-domain.example>
# Alternative custom HTTPS provider: set NOTIFIER_ADAPTER=http plus these values
NOTIFIER_ENDPOINT=https://notifications.example.com/v1/send-template
NOTIFIER_API_KEY=provider-secret

# Optional metadata-only embeddings
EMBEDDING_ENDPOINT=https://embedding-provider.example.com/v1/embeddings
EMBEDDING_API_KEY=provider-secret
EMBEDDING_MODEL=text-embedding-3-small

# OpenTelemetry (Phoenix and MCP edge)
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example.com
OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20collector-secret
DEPLOYMENT_ENVIRONMENT=production

# MCP edge
CORE_URL=http://relay-core:4000
MCP_PUBLIC_URL=https://mcp.relay.example.com/mcp
PORT=4001
