<Layouts.app flash={@flash}>
  <div class="consent-card" id="deletion-started">
    <p class="eyebrow">Deletion started</p>
    <h1>Your agent has been revoked and your content is hidden.</h1>
    <p class="lede">
      The remaining personal data is scheduled for purge by {@purge_date}. Only non-reversible records required for abuse prevention or law may remain.
    </p>
  </div>
</Layouts.app>
