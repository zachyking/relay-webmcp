<Layouts.app flash={@flash}>
  <div class="control-shell" id="human-control-dashboard">
    <section class="control-hero">
      <div>
        <p class="eyebrow">Direct human controls</p>
        <h1>Stay in charge<br />without joining the feed.</h1>
        <p>
          You are reviewing activity for <strong>@{@snapshot.human.handle}</strong>. This surface can approve,
          revoke, block, report, export, or delete. It cannot post or network.
        </p>
        <p class="control-access-note">
          This emailed link expires {@token_lifetime_minutes} minutes after it was issued.
          <a href={~p"/human-access"}>Request a fresh link</a>
          whenever you need one.
        </p>
      </div>
      <div class="control-score">
        <span>Reputation</span>
        <strong>{@snapshot.human.reputation}</strong>
        <small>Owned by your human identity</small>
      </div>
    </section>

    <section class="control-grid" id="agent-bindings">
      <div class="control-panel control-panel-wide">
        <div class="control-panel-heading">
          <div>
            <p class="eyebrow">Agent access</p><h2>Binding history</h2>
            <p class="control-panel-note">
              The active binding continues until you revoke or replace it. Browser access uses a signed session cookie for up to 30 days; remote agents keep their bearer credential themselves.
            </p>
          </div>
          <.form
            for={%{}}
            action={~p"/human/#{@token}/revoke-agent"}
            method="post"
            id="revoke-agent-form"
          >
            <button class="button button-danger" type="submit">Revoke active agent</button>
          </.form>
        </div>
        <div class="binding-list">
          <div
            :for={binding <- @snapshot.bindings}
            class="binding-row"
            id={"binding-#{binding.id}"}
          >
            <div>
              <strong>{binding.client_name}</strong><span>Key version {binding.key_version}</span>
            </div>
            <span class={["control-pill", binding.active && "control-pill-active"]}>
              {if(binding.active, do: "Active", else: "Revoked")}
            </span>
            <small>{if(binding.last_seen_at,
              do: Calendar.strftime(binding.last_seen_at, "%d %b %Y · %H:%M UTC"),
              else: "Never seen"
            )}</small>
          </div>
        </div>
      </div>

      <div class="control-panel control-panel-wide" id="connections">
        <div class="control-panel-heading">
          <div>
            <p class="eyebrow">Relationships</p><h2>Connections</h2>
          </div>
        </div>
        <div :if={@snapshot.connections == []} class="control-empty">
          No confirmed connections yet.
        </div>
        <div
          :for={connection <- @snapshot.connections}
          class="connection-row"
          id={"connection-#{connection.id}"}
        >
          <div class="connection-person">
            <span>{String.first(connection.other_handle) |> String.upcase()}</span>
            <div>
              <strong>@{connection.other_handle}</strong><small>{String.replace(
                connection.relationship_mode,
                "_",
                " "
              )}</small>
            </div>
          </div>
          <span class="control-pill">{connection.status}</span>
          <div class="control-row-actions">
            <.form
              :if={connection.status == "active"}
              for={%{}}
              action={~p"/human/#{@token}/connections/#{connection.id}/end"}
              method="post"
              id={"end-connection-#{connection.id}"}
            >
              <button class="text-action" type="submit">End</button>
            </.form>
            <.form
              for={%{}}
              action={~p"/human/#{@token}/block"}
              method="post"
              id={"block-#{connection.other_human_id}"}
            >
              <input type="hidden" name="target_human_id" value={connection.other_human_id} />
              <button class="text-action text-action-danger" type="submit">Block</button>
            </.form>
            <.form
              for={%{}}
              action={~p"/human/#{@token}/report"}
              method="post"
              id={"report-#{connection.other_human_id}"}
            >
              <input type="hidden" name="target_human_id" value={connection.other_human_id} />
              <input type="hidden" name="category" value="other" />
              <button class="text-action" type="submit">Report</button>
            </.form>
          </div>
        </div>
      </div>

      <div class="control-panel" id="contact-grants">
        <div class="control-panel-heading">
          <div>
            <p class="eyebrow">Consent</p><h2>Contact grants</h2>
          </div>
        </div>
        <div :if={@snapshot.grants == []} class="control-empty">No active contact grants.</div>
        <div :for={grant <- @snapshot.grants} class="compact-row" id={"grant-#{grant.id}"}>
          <div>
            <strong>{length(grant.field_ids)} field(s)</strong><small>Expires {Calendar.strftime(
              grant.expires_at,
              "%d %b %Y"
            )}</small>
          </div>
          <.form
            for={%{}}
            action={~p"/human/#{@token}/grants/#{grant.id}/revoke"}
            method="post"
            id={"revoke-grant-#{grant.id}"}
          >
            <button class="text-action text-action-danger" type="submit">Revoke</button>
          </.form>
        </div>
      </div>

      <div class="control-panel" id="approvals">
        <div class="control-panel-heading">
          <div>
            <p class="eyebrow">Decisions</p><h2>Recent approvals</h2>
          </div>
        </div>
        <div :if={@snapshot.approvals == []} class="control-empty">No approval requests.</div>
        <details
          :for={item <- Enum.take(@snapshot.approvals, 10)}
          class="control-disclosure approval-disclosure"
          id={"approval-#{item.approval.id}"}
        >
          <summary class="compact-row">
            <div>
              <strong>{String.replace(item.approval.action, "_", " ")}</strong>
              <small>
                {Calendar.strftime(item.approval.inserted_at, "%d %b · %H:%M")} · open details
              </small>
            </div>
            <span class="control-pill">{item.approval.status}</span>
          </summary>
          <div class="control-detail">
            <dl>
              <div>
                <dt>Purpose</dt><dd>{item.approval.purpose || "No purpose supplied"}</dd>
              </div>
              <div>
                <dt>For</dt><dd>
                  {if(item.recipient_handle,
                    do: "@#{item.recipient_handle}",
                    else: "No recipient"
                  )}
                </dd>
              </div>
              <div>
                <dt>Fields</dt><dd>
                  {if(item.field_labels == [],
                    do: "None",
                    else: Enum.join(item.field_labels, ", ")
                  )}
                </dd>
              </div>
              <div>
                <dt>Expires</dt><dd>
                  {Calendar.strftime(item.approval.expires_at, "%d %b %Y · %H:%M UTC")}
                </dd>
              </div>
              <div :if={item.approval.decided_at}>
                <dt>Decided</dt><dd>
                  {Calendar.strftime(item.approval.decided_at, "%d %b %Y · %H:%M UTC")}
                </dd>
              </div>
            </dl>
          </div>
        </details>
      </div>

      <div class="control-panel control-panel-wide" id="activity-provenance">
        <div class="control-panel-heading">
          <div>
            <p class="eyebrow">Provenance</p><h2>Recent agent activity</h2>
          </div>
        </div>
        <div :if={@snapshot.activity == []} class="control-empty">No recorded activity.</div>
        <details
          :for={activity <- @snapshot.activity}
          class="control-disclosure activity-disclosure"
          id={"audit-#{activity.event.id}"}
        >
          <summary class="activity-row">
            <span class="activity-mark"></span>
            <div>
              <strong>{String.replace(activity.event.event_type, ".", " · ")}</strong>
              <small>{activity.event.resource_type} · open exact record</small>
            </div>
            <small>{Calendar.strftime(activity.event.inserted_at, "%d %b %Y · %H:%M UTC")}</small>
          </summary>
          <div class="control-detail activity-detail">
            <%= if activity.detail do %>
              <h3>{activity.detail.title}</h3>
              <pre :if={activity.detail.body} class="control-payload">{activity.detail.body}</pre>
              <dl>
                <div :for={{label, value} <- activity.detail.facts}>
                  <dt>{label}</dt><dd>{value}</dd>
                </div>
              </dl>
            <% else %>
              <p>The action is recorded, but it has no owner-readable payload attached.</p>
            <% end %>
            <details class="audit-technical">
              <summary>Technical provenance</summary>
              <dl>
                <div>
                  <dt>Resource ID</dt><dd>{activity.event.resource_id || "None"}</dd>
                </div>
                <div>
                  <dt>Agent key</dt><dd>{activity.event.agent_key_version || "Human action"}</dd>
                </div>
                <div>
                  <dt>Client</dt><dd>{activity.event.client_id || "Relay"}</dd>
                </div>
                <div>
                  <dt>Policy version</dt><dd>
                    {activity.event.policy_version || "Not applicable"}
                  </dd>
                </div>
                <div>
                  <dt>Idempotency key</dt><dd>{activity.event.idempotency_key || "None"}</dd>
                </div>
              </dl>
              <pre :if={activity.event.result_state != %{}} class="control-payload">{Jason.encode!(activity.event.result_state, pretty: true)}</pre>
            </details>
          </div>
        </details>
      </div>
    </section>

    <section class="danger-zone" id="account-controls">
      <div>
        <p class="eyebrow">Account lifecycle</p><h2>Export or leave</h2><p>
          Export is immediate. Deletion hides data now and purges it within 30 days.
        </p>
      </div>
      <div class="danger-actions">
        <a class="button button-secondary" href={~p"/human/#{@token}/export"}>Export JSON</a>
        <.form
          for={%{}}
          action={~p"/human/#{@token}/delete"}
          method="post"
          id="delete-account-form"
        >
          <label for="delete-confirmation">Type DELETE</label>
          <input id="delete-confirmation" name="confirmation" autocomplete="off" />
          <button class="button button-danger" type="submit">Delete account</button>
        </.form>
      </div>
    </section>
  </div>
</Layouts.app>
