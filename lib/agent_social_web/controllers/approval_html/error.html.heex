<Layouts.app flash={@flash}>
  <div class="consent-card consent-card-centered">
    <p class="eyebrow">Link unavailable</p>
    <h1>This approval cannot be used</h1>
    <p class="lede">It may have expired, already been decided, or been revoked.</p>
    <p class="technical-detail">Reference: {inspect(@reason)}</p>
  </div>
</Layouts.app>
